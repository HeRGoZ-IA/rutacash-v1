# ADEX-Staging · Supabase Free, sa-east-1, datos SINTÉTICOS. Copiar a .env.staging
# (ignorado por Git) y rellenar en el equipo local. NUNCA valores reales aquí.
# No usar la referencia ni las claves del proyecto de la POC (ADEX-SaaS-POC-0A1).

# Referencia del proyecto ADEX-Staging (Project Settings → General).
ADEX_STAGING_PROJECT_REF=
# https://<ref>.supabase.co
SUPABASE_URL=
# Clave publicable (sb_publishable_…): la usa el cliente para iniciar sesión y recuperar acceso.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…): solo aprovisiona y borra identidades sintéticas. Nunca llega a PostgreSQL.
SUPABASE_SECRET_KEY=
# Contraseña de la base (rol postgres): solo migraciones y semillas.
SUPABASE_DB_PASSWORD=
# Host del pooler (Connect → Session pooler), p. ej. aws-0-sa-east-1.pooler.supabase.com
SUPABASE_POOLER_HOST=
# Declaración del propietario: free:<ref>:sa-east-1 (plan Free sin método de pago).
ADEX_STAGING_OWNER_ATTESTATION=
# OBLIGATORIO: token de la Management API (demuestra nombre, región y estado; revocar al terminar).
SUPABASE_ACCESS_TOKEN=
# Opcional: certificado raíz del proyecto, guardado FUERA del repositorio.
ADEX_PG_SSL_CA=
