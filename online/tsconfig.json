{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/bridge/*",
        "../src/*"
      ],
      "@clean/*": [
        "../src/*"
      ],
      "dexie-react-hooks": [
        "./src/bridge/vendor/dexie-react-hooks.ts"
      ],
      "dexie": [
        "./src/bridge/vendor/dexie.ts"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "src",
    "../saas/src/client"
  ]
}
