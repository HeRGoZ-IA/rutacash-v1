# ADEX Fase 0A.1 · Variables del proyecto Supabase EXPERIMENTAL.
# Copiar a .env.managed (ignorado por Git) y rellenar en el equipo local.
# NUNCA poner valores reales en este archivo ni en ningún archivo versionado.

# Referencia del proyecto (20 caracteres, Project Settings → General).
ADEX_POC_PROJECT_REF=
# https://<ref>.supabase.co
SUPABASE_URL=
# Clave publicable (sb_publishable_…). Alternativa legada: SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…). Solo crea y borra usuarios sintéticos en el arnés. Alternativa legada: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Contraseña de la base de datos del proyecto (rol postgres). Solo para preparar el esquema y verificar.
SUPABASE_DB_PASSWORD=
# Host del pooler compartido (Connect → Session pooler), p. ej. aws-0-<región>.pooler.supabase.com
SUPABASE_POOLER_HOST=

# Verificación del proyecto ANTES de cualquier SQL (una de las dos):
# a) Token personal de la Management API (Account → Access Tokens). Se usa solo para LEER nombre, región, plan y configuración.
SUPABASE_ACCESS_TOKEN=
# b) Declaración del propietario si no hay token: free:<ref>:<región>
ADEX_POC_OWNER_ATTESTATION=

# Opcional: ruta local del certificado raíz del proyecto (Database Settings → SSL → Download certificate).
ADEX_PG_SSL_CA=
